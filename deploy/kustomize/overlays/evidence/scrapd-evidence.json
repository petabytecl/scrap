{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Client API",
      "type": "row"
    },
    {
      "id": 1,
      "title": "RPC Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(scrap_rpc_server_requests_total[1m])) by (rpc_method, rpc_grpc_status_code)",
          "legendFormat": "{{rpc_method}} ({{rpc_grpc_status_code}})"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 2,
      "title": "RPC Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(scrap_rpc_server_duration_bucket[1m])) by (le, rpc_method))",
          "legendFormat": "p50 {{rpc_method}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(scrap_rpc_server_duration_bucket[1m])) by (le, rpc_method))",
          "legendFormat": "p95 {{rpc_method}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(scrap_rpc_server_duration_bucket[1m])) by (le, rpc_method))",
          "legendFormat": "p99 {{rpc_method}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 3,
      "title": "RPC Error Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(scrap_rpc_server_requests_total{rpc_grpc_status_code!=\"0\"}[5m])) / sum(rate(scrap_rpc_server_requests_total[5m]))",
          "legendFormat": "error rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.001 },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 200,
      "title": "Write Path Stages",
      "type": "row"
    },
    {
      "id": 10,
      "title": "Write Stage Latency (avg)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(scrap_write_stage_duration_sum[1m])) by (scrap_write_stage) / sum(rate(scrap_write_stage_duration_count[1m])) by (scrap_write_stage)",
          "legendFormat": "{{scrap_write_stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 11,
      "title": "Write Stage Latency (p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(scrap_write_stage_duration_bucket[1m])) by (le, scrap_write_stage))",
          "legendFormat": "p99 {{scrap_write_stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 300,
      "title": "Raft Health",
      "type": "row"
    },
    {
      "id": 20,
      "title": "Raft Leader",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "scrap_raft_is_leader",
          "legendFormat": "is_leader"
        }
      ]
    },
    {
      "id": 21,
      "title": "Raft Applied Index",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "scrap_raft_applied_index",
          "legendFormat": "applied_index"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 400,
      "title": "Upload Pipeline",
      "type": "row"
    },
    {
      "id": 30,
      "title": "Upload Pressure Level",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "scrap_upload_pressure_level",
          "legendFormat": "pressure_level"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 2 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "id": 31,
      "title": "Upload Pending",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "scrap_upload_pending_bytes",
          "legendFormat": "pending_bytes"
        },
        {
          "expr": "scrap_upload_pending_blocks * 67108864",
          "legendFormat": "pending_blocks (scaled)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "id": 32,
      "title": "Upload Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(scrap_upload_total[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "id": 33,
      "title": "Upload Concurrency & Auth Paused",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "scrap_upload_concurrency",
          "legendFormat": "concurrency"
        },
        {
          "expr": "scrap_upload_auth_paused",
          "legendFormat": "auth_paused"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 },
      "id": 500,
      "title": "Scrub",
      "type": "row"
    },
    {
      "id": 40,
      "title": "Light Scrub Runs",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(scrap_scrub_light_runs_total[5m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "id": 41,
      "title": "Deep Scrub Progress & Corruptions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "scrap_scrub_deep_progress_ratio",
          "legendFormat": "progress"
        },
        {
          "expr": "sum(rate(scrap_scrub_deep_corruptions_total[5m])) by (type)",
          "legendFormat": "corruption:{{type}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 57 },
      "id": 600,
      "title": "Process Resources",
      "type": "row"
    },
    {
      "id": 50,
      "title": "Goroutines",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "process_runtime_go_goroutines",
          "legendFormat": "goroutines"
        }
      ]
    },
    {
      "id": 51,
      "title": "Heap Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "process_runtime_go_mem_heap_alloc",
          "legendFormat": "heap_alloc"
        },
        {
          "expr": "process_runtime_go_mem_heap_sys",
          "legendFormat": "heap_sys"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "id": 52,
      "title": "GC Pause Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(process_runtime_go_gc_pause_total[1m])",
          "legendFormat": "gc_pause_rate"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["scrap", "evidence", "stress"],
  "templating": {
    "list": [
      {
        "current": { "text": "Mimir", "value": "Mimir" },
        "hide": 0,
        "label": "Data Source",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "S.C.R.A.P. Evidence",
  "uid": "scrap-evidence"
}
