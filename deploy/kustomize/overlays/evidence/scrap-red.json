{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Client API (RED)",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Request Rate by Method / Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(scrap_rpc_server_requests_total[5m])) by (rpc_method, rpc_grpc_status_code)",
          "legendFormat": "{{rpc_method}} ({{rpc_grpc_status_code}})"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 2,
      "title": "Latency p50 / p95 / p99 by Method",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(scrap_rpc_server_duration_seconds_bucket[5m])) by (le, rpc_method))",
          "legendFormat": "p50 {{rpc_method}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(scrap_rpc_server_duration_seconds_bucket[5m])) by (le, rpc_method))",
          "legendFormat": "p95 {{rpc_method}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(scrap_rpc_server_duration_seconds_bucket[5m])) by (le, rpc_method))",
          "legendFormat": "p99 {{rpc_method}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(scrap_rpc_server_requests_total{rpc_grpc_status_code!=\"0\"}[5m])) by (rpc_method) / clamp_min(sum(rate(scrap_rpc_server_requests_total[5m])) by (rpc_method), 1)",
          "legendFormat": "{{rpc_method}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 200,
      "title": "Write Path Stages (RED)",
      "type": "row"
    },
    {
      "id": 10,
      "title": "Stage Latency avg by Stage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(scrap_write_stage_duration_seconds_sum[5m])) by (scrap_write_stage) / clamp_min(sum(rate(scrap_write_stage_duration_seconds_count[5m])) by (scrap_write_stage), 1)",
          "legendFormat": "{{scrap_write_stage}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 11,
      "title": "Stage Latency p99 by Stage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(scrap_write_stage_duration_seconds_bucket[5m])) by (le, scrap_write_stage))",
          "legendFormat": "p99 {{scrap_write_stage}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 12,
      "title": "Peer Replicate Rate by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(scrap_write_stage_duration_seconds_count{scrap_write_stage=\"peer_replicate\"}[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 13,
      "title": "Peer Replicate p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(scrap_write_stage_duration_seconds_bucket{scrap_write_stage=\"peer_replicate\"}[5m])) by (le))",
          "legendFormat": "p99 peer_replicate"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ],
  "schemaVersion": 39,
  "tags": ["scrap", "evidence", "red"],
  "templating": {
    "list": [
      {
        "current": { "text": "Mimir", "value": "Mimir" },
        "hide": 0,
        "label": "Data Source",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "S.C.R.A.P. — RED (requests)",
  "uid": "scrap-red"
}
