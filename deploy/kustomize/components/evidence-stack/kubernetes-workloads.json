{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Readiness",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Deployment Replicas Missing",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(clamp_min(kube_deployment_spec_replicas - kube_deployment_status_replicas_ready, 0))", "legendFormat": "missing" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "StatefulSet Replicas Missing",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(clamp_min(kube_statefulset_replicas - kube_statefulset_status_replicas_ready, 0))", "legendFormat": "missing" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "DaemonSet Pods Missing",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(clamp_min(kube_daemonset_status_desired_number_scheduled - kube_daemonset_status_number_ready, 0))", "legendFormat": "missing" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Container Restarts",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(increase(kube_pod_container_status_restarts_total[5m]))", "legendFormat": "last 5m" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Controllers",
      "type": "row"
    },
    {
      "id": 10,
      "title": "Deployment Ready / Desired",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(kube_deployment_status_replicas_ready) by (namespace, deployment)", "legendFormat": "{{namespace}}/{{deployment}} ready" },
        { "expr": "sum(kube_deployment_spec_replicas) by (namespace, deployment)", "legendFormat": "{{namespace}}/{{deployment}} desired" }
      ]
    },
    {
      "id": 11,
      "title": "StatefulSet Ready / Desired",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(kube_statefulset_status_replicas_ready) by (namespace, statefulset)", "legendFormat": "{{namespace}}/{{statefulset}} ready" },
        { "expr": "sum(kube_statefulset_replicas) by (namespace, statefulset)", "legendFormat": "{{namespace}}/{{statefulset}} desired" }
      ]
    },
    {
      "id": 12,
      "title": "DaemonSet Ready / Desired",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(kube_daemonset_status_number_ready) by (namespace, daemonset)", "legendFormat": "{{namespace}}/{{daemonset}} ready" },
        { "expr": "sum(kube_daemonset_status_desired_number_scheduled) by (namespace, daemonset)", "legendFormat": "{{namespace}}/{{daemonset}} desired" }
      ]
    },
    {
      "id": 13,
      "title": "Jobs Failed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(kube_job_status_failed) by (namespace, job_name)", "legendFormat": "{{namespace}}/{{job_name}}" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102,
      "title": "Pods and containers",
      "type": "row"
    },
    {
      "id": 20,
      "title": "Pods Not Ready",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(kube_pod_status_ready{condition=\"false\"}) by (namespace, pod)", "legendFormat": "{{namespace}}/{{pod}}" }
      ]
    },
    {
      "id": 21,
      "title": "Container Restarts by Pod",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(increase(kube_pod_container_status_restarts_total[5m])) by (namespace, pod, container)", "legendFormat": "{{namespace}}/{{pod}} {{container}}" }
      ]
    },
    {
      "id": 22,
      "title": "Waiting Containers",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(kube_pod_container_status_waiting_reason) by (namespace, pod, container, reason)", "legendFormat": "{{namespace}}/{{pod}} {{container}} {{reason}}" }
      ]
    },
    {
      "id": 23,
      "title": "Terminated Containers",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(kube_pod_container_status_terminated_reason) by (namespace, pod, container, reason)", "legendFormat": "{{namespace}}/{{pod}} {{container}} {{reason}}" }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["scrap", "evidence", "kubernetes", "workloads"],
  "templating": {
    "list": [
      {
        "current": { "text": "Mimir", "value": "Mimir" },
        "hide": 0,
        "label": "Data Source",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Kubernetes - Workloads",
  "uid": "scrap-kubernetes-workloads"
}
