package templates

templ Shell(data DashboardData) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>S.C.R.A.P. Admin</title>
			<link rel="icon" href="/admin/static/assets/favicon.ico"/>
			<link rel="stylesheet" href="/admin/static/admin.css"/>
			<script src="/admin/static/htmx.min.js" defer></script>
			<script src="/admin/static/admin.js" defer></script>
		</head>
		<body>
			<div class="app-shell">
				<aside class="sidebar">
					<div class="brand">
						<img class="brand-logo" src="/admin/static/assets/logo-petabyte-color-white.png" alt="Petabyte"/>
						<div>
							<div class="brand-title">S.C.R.A.P.</div>
							<div class="brand-subtitle">Admin</div>
						</div>
					</div>
					<nav>
						for _, group := range groupedNav(data.Nav) {
							<div class="nav-group">
								<div class="nav-heading">{ group.Name }</div>
								for _, item := range group.Items {
									<a class={ navClass(data, item) } href={ safeURL(item.Href) } hx-get={ item.Href } hx-target="#main-content" hx-push-url="true">
										<span>{ item.Label }</span>
									</a>
								}
							</div>
						}
					</nav>
					<div class="sidebar-footer">
						<div>profile</div>
						<strong>{ data.Capacity.ProfileID }</strong>
					</div>
				</aside>
				<main class="content">
					<header class="topbar">
						<div>
							<div class="breadcrumb">Admin / { pageTitle(data.ActiveView) }</div>
							<h1>{ pageTitle(data.ActiveView) }</h1>
						</div>
						<div class="topbar-status">
							<span class="pill">local</span>
							<span id="admin-clock">{ data.GeneratedAt }</span>
							<span class="live-dot"></span>
							<span>Live</span>
							<button class="tool-button" type="button" data-tweaks-toggle aria-expanded="false" aria-controls="tweaks-panel">Tune</button>
						</div>
					</header>
					<section id="main-content" class="view">
						@View(data)
					</section>
				</main>
				@TweaksPanel()
			</div>
		</body>
	</html>
}

templ TweaksPanel() {
	<aside id="tweaks-panel" class="tweaks-panel" data-tweaks-panel hidden>
		<div class="panel-heading">
			<div>
				<div class="eyebrow">Tweaks</div>
				<strong>Dashboard controls</strong>
			</div>
			<button class="text-button" type="button" data-tweaks-close>Close</button>
		</div>
		<div class="tweak-group">
			<label for="tweak-refresh">Auto-refresh</label>
			<div class="tweak-slider-row">
				<input id="tweak-refresh" type="range" min="5" max="120" step="5" value="20" data-tweak-refresh/>
				<output for="tweak-refresh" data-tweak-refresh-output>20s</output>
			</div>
		</div>
		<label class="tweak-toggle">
			<span>Compact numbers</span>
			<input type="checkbox" data-tweak-compact checked/>
		</label>
		<label class="tweak-toggle">
			<span>Sparklines</span>
			<input type="checkbox" data-tweak-sparklines checked/>
		</label>
		<div class="tweak-group">
			<div class="tweak-label">Accent</div>
			<div class="swatch-row">
				<button class="swatch active" type="button" data-tweak-accent="#0093d0" style="--swatch: #0093d0" aria-label="Petabyte blue"></button>
				<button class="swatch" type="button" data-tweak-accent="#0ea5e9" style="--swatch: #0ea5e9" aria-label="Sky blue"></button>
				<button class="swatch" type="button" data-tweak-accent="#6366f1" style="--swatch: #6366f1" aria-label="Indigo"></button>
				<button class="swatch" type="button" data-tweak-accent="#34d399" style="--swatch: #34d399" aria-label="Green"></button>
			</div>
		</div>
	</aside>
}

templ View(data DashboardData) {
	switch data.ActiveView {
		case "capacity":
			@Capacity(data)
		case "members":
			@Members(data)
		case "raft":
			@Raft(data)
		case "clients":
			@Clients(data)
		case "backend":
			@Backend(data)
		case "openbao":
			@OpenBao(data)
		case "operations":
			@Operations(data)
		case "repair":
			@Repair(data)
		default:
			@Overview(data)
	}
}

templ Overview(data DashboardData) {
	@Errors(data)
	<section class="status-strip">
		<div>
			<div class="eyebrow">Production write ACK</div>
			<strong>local validation mode</strong>
			<p>Dashboard reads current local admin state. Production readiness evidence still comes from release gates.</p>
		</div>
		<div class="status-grid">
			<span><i class="dot success"></i>backend local</span>
			<span><i class="dot success"></i>OpenBao evidence external</span>
			<span><i class="dot warning"></i>capacity advisory</span>
		</div>
	</section>
	<section class="metrics-grid">
		@Metric("Shards", numberText(uint64(data.Summary.ShardCount)), "authoritative metadata partitions")
		@Metric("Members", numberText(uint64(data.Summary.StorageMemberCount)), "storage members visible to admin API")
		@Metric("Storage", bytesText(data.Summary.LocalBytesUsed), percentText(data.Summary.LocalBytesUsed, data.Summary.LocalBytesCapacity) + " of " + bytesText(data.Summary.LocalBytesCapacity))
		@Metric("Degraded", numberText(uint64(data.Summary.DegradedDocumentCount)), "documents requiring repair")
	</section>
	<section class="panel-grid">
		<div class="panel wide">
			<div class="panel-heading">
				<div class="eyebrow">Disk capacity</div>
				<strong>{ bytesText(data.Summary.LocalBytesUsed) } / { bytesText(data.Summary.LocalBytesCapacity) }</strong>
			</div>
			<div class="progress">
				<div class="progress-fill" style={ widthStyle(percentValue(data.Summary.LocalBytesUsed, data.Summary.LocalBytesCapacity)) }></div>
			</div>
			<div class="meta-row">
				<span>Usable remaining <strong>{ bytesText(data.Capacity.UsableBytesRemaining) }</strong></span>
				if data.Capacity.HasMeasuredIngressRate {
					<span>Ingress <strong>{ bytesText(data.Capacity.EstimatedBytesPerDay) }/day</strong></span>
					<span>Runway <strong>{ numberText(uint64(data.Capacity.RunwayDays)) } days</strong></span>
				} else {
					<span>Ingress <strong>not measured locally</strong></span>
				}
			</div>
		</div>
		<div class="panel">
			<div class="eyebrow">Reliability</div>
			<div class="list-stat"><span>Pending operations</span><strong>{ numberText(uint64(data.Summary.PendingOperationCount)) }</strong></div>
			<div class="list-stat"><span>Repair queue</span><strong>{ numberText(uint64(data.RepairQueueCount)) }</strong></div>
			<div class="list-stat"><span>Capacity warnings</span><strong>{ numberText(uint64(len(data.Capacity.Warnings))) }</strong></div>
		</div>
	</section>
	<section class="panel">
		<div class="panel-heading">
			<div>
				<div class="eyebrow">Operations</div>
				<strong>Recent operation state</strong>
			</div>
			<a class="text-link" href="/admin/views/operations" hx-get="/admin/views/operations" hx-target="#main-content" hx-push-url="true">View all</a>
		</div>
		@OperationsTable(data)
	</section>
}

templ Capacity(data DashboardData) {
	@Errors(data)
	<section class="metrics-grid">
		@Metric("Profile", data.Capacity.ProfileID, "capacity evidence scope")
		@Metric("Remaining", bytesText(data.Capacity.UsableBytesRemaining), "usable local filesystem bytes")
		@Metric("Runway", numberText(uint64(data.Capacity.RunwayDays)), "days, if measured")
	</section>
	<section class="panel">
		<div class="panel-heading">
			<div>
				<div class="eyebrow">Capacity warnings</div>
				<strong>Local profile notes</strong>
			</div>
		</div>
		if len(data.Capacity.Warnings) == 0 {
			<p class="empty">No capacity warnings reported by the admin API.</p>
		} else {
			<div class="warning-list">
				for _, warning := range data.Capacity.Warnings {
					<div class="warning-item">
						<strong>{ warning.Code }</strong>
						<p>{ warning.Message }</p>
					</div>
				}
			</div>
		}
	</section>
}

templ Operations(data DashboardData) {
	@Errors(data)
	<section class="panel">
		<div class="panel-heading">
			<div>
				<div class="eyebrow">Operations</div>
				<strong>Durable admin operation store</strong>
			</div>
			<span class="pill">{ numberText(uint64(len(data.Operations))) } total</span>
		</div>
		<div class="filter-row" id="operation-filters">
			for _, filter := range data.OperationFilters {
				<a class={ operationFilterClass(data.OperationFilter, filter.ID) } href={ safeURL(filter.Href) } hx-get={ filter.Href } hx-target="#main-content" hx-push-url="true">{ filter.Label }</a>
			}
		</div>
		@OperationsTable(data)
	</section>
}

templ OperationsTable(data DashboardData) {
	if len(data.Operations) == 0 {
		<p class="empty">No operations have been recorded.</p>
	} else {
		<table>
			<thead>
				<tr>
					<th>ID</th>
					<th>Type</th>
					<th>State</th>
					<th>Progress</th>
					<th>Requested</th>
				</tr>
			</thead>
			<tbody>
				for _, operation := range data.Operations {
					<tr>
						<td class="mono">{ operation.ID }</td>
						<td>{ operation.Type }</td>
						<td><span class={ stateClass(operation.State) }>{ shortState(operation.State) }</span></td>
						<td>
							<div class="table-progress">
								<div class="progress">
									<div class="progress-fill" style={ widthStyle(progressWidth(operation.Completed, operation.Total)) }></div>
								</div>
								<span>{ operation.Message }</span>
							</div>
						</td>
						<td class="mono muted">
							<div>{ operation.Requested }</div>
							<button class="text-button" type="button" hx-get={ operationDetailHref(operation.ID) } hx-target={ operationDetailTarget(operation.ID) } hx-swap="innerHTML">Details</button>
						</td>
					</tr>
					<tr class="operation-detail-row">
						<td colspan="5">
							<div id={ operationDetailTargetID(operation.ID) }></div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ OperationDetail(operation OperationData) {
	<div class="operation-detail-card">
		<div class="detail-grid">
			<div>
				<div class="eyebrow">Operation</div>
				<strong>{ operation.Type }</strong>
				<p class="mono muted">{ operation.ID }</p>
			</div>
			<div>
				<div class="eyebrow">State</div>
				<span class={ stateClass(operation.State) }>{ shortState(operation.State) }</span>
			</div>
			<div>
				<div class="eyebrow">Requested by</div>
				<strong>{ operation.RequestedBy }</strong>
			</div>
			<div>
				<div class="eyebrow">Dry run</div>
				if operation.DryRun {
					<strong>true</strong>
				} else {
					<strong>false</strong>
				}
			</div>
			<div>
				<div class="eyebrow">Requested</div>
				<span class="mono muted">{ operation.Requested }</span>
			</div>
			<div>
				<div class="eyebrow">Started</div>
				<span class="mono muted">{ operation.Started }</span>
			</div>
			<div>
				<div class="eyebrow">Finished</div>
				<span class="mono muted">{ operation.Finished }</span>
			</div>
		</div>
		<div class="table-progress detail-progress">
			<div class="progress">
				<div class="progress-fill" style={ widthStyle(progressWidth(operation.Completed, operation.Total)) }></div>
			</div>
			<span>{ operation.Message }</span>
		</div>
	</div>
}

templ Metric(eyebrow string, value string, sub string) {
	<div class="metric-card">
		<div class="eyebrow">{ eyebrow }</div>
		<div class="metric-value" data-full-value={ value } data-compact-value={ compactMetricValue(value) }>{ value }</div>
		<div class="metric-sub">{ sub }</div>
	</div>
}

templ Errors(data DashboardData) {
	if len(data.Errors) > 0 {
		<div class="error-stack">
			for _, message := range data.Errors {
				<div class="error-item">{ message }</div>
			}
		</div>
	}
}
