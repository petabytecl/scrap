package templates

templ Members(data DashboardData) {
	@Errors(data)
	<section class="metrics-grid">
		@Metric("Members", numberText(uint64(data.Summary.StorageMemberCount)), "storage members visible to admin summary")
		@Metric("Shards", numberText(uint64(data.Summary.ShardCount)), "metadata partitions tracked locally")
		@Metric("Repair queue", countText(data.RepairQueueCount), "items awaiting operator attention")
	</section>
	<section class="panel">
		<div class="panel-heading">
			<div>
				<div class="eyebrow">Infrastructure</div>
				<strong>Member inventory surface</strong>
			</div>
		</div>
		<div class="coverage-grid">
			@CoverageItem("Live count", "healthy", "Cluster summary reports the storage member count.")
			@CoverageItem("Local detail route", "healthy", "Local non-production storage exposes the stable local member detail route.")
			@CoverageItem("Kubernetes tab", "unknown", "Pod and node metadata are not exposed by the current admin API.")
		</div>
	</section>
	<section class="panel">
		<div class="panel-heading">
			<div>
				<div class="eyebrow">Storage member</div>
				<strong>Local member detail</strong>
			</div>
			<a class="text-link" href={ memberDetailHref("local") } hx-get={ memberDetailHref("local") } hx-target="#main-content" hx-push-url="true">Open detail</a>
		</div>
		<a class="member-card" href={ memberDetailHref("local") } hx-get={ memberDetailHref("local") } hx-target="#main-content" hx-push-url="true">
			<div>
				<div class="eyebrow">member id</div>
				<strong>local</strong>
				<p>Single-node local non-production member.</p>
			</div>
			<span class="status succeeded">online</span>
		</a>
	</section>
}

templ MemberDetail(data DashboardData) {
	@Errors(data)
	<section class="status-strip">
		<div>
			<div class="eyebrow">Members / { data.MemberDetail.ID }</div>
			<strong>{ data.MemberDetail.ID }</strong>
			<p>Storage member detail is backed by InspectService.GetMember and MemberService.GetEvictionSafety.</p>
		</div>
		<div class="status-grid">
			<span><i class="dot success"></i>{ data.MemberDetail.CellID }</span>
			<span><i class="dot warning"></i>{ evictionText(data.MemberDetail.Eviction) }</span>
			if data.MemberDetail.Cordoned {
				<span><i class="dot warning"></i>cordoned</span>
			}
		</div>
	</section>
	<section class="metrics-grid">
		@Metric("State", shortMemberState(data.MemberDetail.State), "current admin member state")
		@Metric("Disk used", bytesText(data.MemberDetail.BytesUsed), percentText(data.MemberDetail.BytesUsed, data.MemberDetail.BytesCapacity) + " of " + bytesText(data.MemberDetail.BytesCapacity))
		@Metric("Last seen", data.MemberDetail.LastSeen, "reported by the local admin API")
	</section>
	<section class="panel">
		<div class="panel-heading">
			<div>
				<div class="eyebrow">Member tabs</div>
				<strong>Live and pending evidence</strong>
			</div>
			<div class="detail-actions">
				<a class="text-link" href={ memberDetailHref(data.MemberDetail.ID) } hx-get={ memberDetailHref(data.MemberDetail.ID) } hx-target="#main-content" hx-push-url="true">Refresh</a>
				<a class="text-link" href="/admin/views/members" hx-get="/admin/views/members" hx-target="#main-content" hx-push-url="true">Back to members</a>
			</div>
		</div>
		<div class="filter-row">
			for _, tab := range data.MemberDetail.Tabs {
				<a class={ memberTabClass(data.MemberDetail.Tab, tab.ID) } href={ memberTabHref(data.MemberDetail.ID, tab.ID) } hx-get={ memberTabHref(data.MemberDetail.ID, tab.ID) } hx-target="#member-tab-content" hx-push-url="true">{ tab.Label }</a>
			}
		</div>
		<div id="member-tab-content">
			@MemberTabContent(data.MemberDetail)
		</div>
	</section>
}

templ MemberTabContent(member MemberDetailData) {
	switch member.Tab {
		case MemberTabKubernetes:
			@MemberKubernetesTab(member)
		case MemberTabRaft:
			@MemberRaftTab(member)
		case MemberTabStorage:
			@MemberStorageTab(member)
		case MemberTabShards:
			@MemberShardsTab(member)
		case MemberTabEvents:
			@MemberEventsTab(member)
		default:
			@MemberOverviewTab(member)
	}
}

templ MemberOverviewTab(member MemberDetailData) {
	<div class="detail-grid">
		<div>
			<div class="eyebrow">State</div>
			<span class={ memberStateClass(member.State) }>{ shortMemberState(member.State) }</span>
		</div>
		<div>
			<div class="eyebrow">Cordoned</div>
			if member.Cordoned {
				<strong>true</strong>
			} else {
				<strong>false</strong>
			}
		</div>
		<div>
			<div class="eyebrow">Eviction safety</div>
			<span class={ evictionStatusClass(member.Eviction) }>{ evictionState(member.Eviction) }</span>
		</div>
		<div>
			<div class="eyebrow">Cell</div>
			<strong>{ member.CellID }</strong>
		</div>
	</div>
	<div class="detail-progress">
		<div class="progress">
			<div class="progress-fill" style={ widthStyle(percentValue(member.BytesUsed, member.BytesCapacity)) }></div>
		</div>
		<div class="meta-row">
			<span>Disk <strong>{ bytesText(member.BytesUsed) }</strong> of <strong>{ bytesText(member.BytesCapacity) }</strong></span>
			<span>Last seen <strong>{ member.LastSeen }</strong></span>
		</div>
	</div>
	if len(member.Eviction.Warnings) > 0 {
		<div class="warning-list detail-progress">
			for _, warning := range member.Eviction.Warnings {
				<div class="warning-item">
					<strong>{ warning.Code }</strong>
					<p>{ warning.Message }</p>
				</div>
			}
		</div>
	} else if member.Eviction.Error != "" {
		<div class="error-stack detail-progress">
			<div class="error-item">{ member.Eviction.Error }</div>
		</div>
	}
}

templ MemberKubernetesTab(member MemberDetailData) {
	<div class="coverage-grid">
		@CoverageItem("Pod conditions", "unknown", "Kubernetes pod conditions are not exposed by the current admin API.")
		@CoverageItem("Node metadata", "unknown", "Node labels, taints, and image metadata need a Kubernetes-backed collector.")
		@CoverageItem("Persistent volume", "unknown", "PV and PVC fields are not present on StorageMember yet.")
	</div>
}

templ MemberRaftTab(member MemberDetailData) {
	<div class="coverage-grid">
		@CoverageItem("Member state", "healthy", "StorageMember exposes the local member state.")
		@CoverageItem("Peer comparison", "unknown", "Per-peer raft lag needs a member or shard detail admin surface.")
		@CoverageItem("Eviction safety", evictionState(member.Eviction), evictionText(member.Eviction))
	</div>
}

templ MemberStorageTab(member MemberDetailData) {
	<div class="detail-grid">
		<div>
			<div class="eyebrow">Bytes used</div>
			<strong>{ bytesText(member.BytesUsed) }</strong>
		</div>
		<div>
			<div class="eyebrow">Capacity</div>
			<strong>{ bytesText(member.BytesCapacity) }</strong>
		</div>
		<div>
			<div class="eyebrow">Usage</div>
			<strong>{ percentText(member.BytesUsed, member.BytesCapacity) }</strong>
		</div>
	</div>
	<div class="detail-progress">
		<div class="progress">
			<div class="progress-fill" style={ widthStyle(percentValue(member.BytesUsed, member.BytesCapacity)) }></div>
		</div>
	</div>
}

templ MemberShardsTab(member MemberDetailData) {
	<div class="coverage-grid">
		@CoverageItem("Shard replicas", "unknown", "StorageMember does not expose per-shard replica rows yet.")
		@CoverageItem("Byte verification", "unknown", "Per-member verification state requires a shard/member detail API.")
	</div>
}

templ MemberEventsTab(member MemberDetailData) {
	<div class="coverage-grid">
		@CoverageItem("Recent events", "unknown", "Member event history is not collected by the local admin API.")
		@CoverageItem("Operator actions", "external", "Cordon and drain operations are recorded in the durable operations store.")
	</div>
}

templ Raft(data DashboardData) {
	@Errors(data)
	<section class="metrics-grid">
		@Metric("Shard count", numberText(uint64(data.Summary.ShardCount)), "raft-backed metadata shards")
		@Metric("Members", numberText(uint64(data.Summary.StorageMemberCount)), "voter/member visibility from summary")
		@Metric("Pending ops", numberText(uint64(data.Summary.PendingOperationCount)), "operations that may affect consensus state")
	</section>
	<section class="panel">
		<div class="panel-heading">
			<div>
				<div class="eyebrow">Raft health</div>
				<strong>Consensus evidence surface</strong>
			</div>
		</div>
		@SignalList(data, "Raft health")
	</section>
}

templ Clients(data DashboardData) {
	@Errors(data)
	<section class="panel">
		<div class="panel-heading">
			<div>
				<div class="eyebrow">Service mesh</div>
				<strong>Client connection coverage</strong>
			</div>
		</div>
		<div class="coverage-grid">
			@CoverageItem("mTLS clients", "unknown", "Connected client telemetry needs a dedicated admin API surface.")
			@CoverageItem("Active streams", "unknown", "gRPC stream accounting is not currently exported to this handler.")
			@CoverageItem("Capability map", "unknown", "Authorization policy capabilities are enforced by gRPC interceptors but not yet rendered here.")
		</div>
	</section>
}

templ Backend(data DashboardData) {
	@Errors(data)
	<section class="metrics-grid">
		@Metric("Storage used", bytesText(data.Summary.LocalBytesUsed), percentText(data.Summary.LocalBytesUsed, data.Summary.LocalBytesCapacity) + " of local capacity")
		@Metric("Backend lag", "not exposed", "requires live backend upload evidence")
		@Metric("Restore lag", "not exposed", "requires restore workflow telemetry")
	</section>
	<section class="panel">
		<div class="panel-heading">
			<div>
				<div class="eyebrow">Backend readiness</div>
				<strong>Upload and restore evidence</strong>
			</div>
		</div>
		@SignalList(data, "Backend lag")
		@SignalList(data, "Restore lag")
	</section>
}

templ OpenBao(data DashboardData) {
	@Errors(data)
	<section class="panel">
		<div class="panel-heading">
			<div>
				<div class="eyebrow">OpenBao</div>
				<strong>Envelope and key custody surface</strong>
			</div>
		</div>
		@SignalList(data, "OpenBao health")
		<div class="coverage-grid">
			@CoverageItem("Transit latency", "unknown", "OpenBao latency samples are produced by release evidence tooling, not the local UI yet.")
			@CoverageItem("Key rotation", "external", "Key-retention and rotation evidence remain release artifacts.")
			@CoverageItem("Audit device", "external", "Audit readiness is validated outside this process.")
		</div>
	</section>
}

templ Repair(data DashboardData) {
	@Errors(data)
	<section class="metrics-grid">
		@Metric("Repair queue", countText(data.RepairQueueCount), "items returned by RepairApplication")
		@Metric("Degraded", numberText(uint64(data.Summary.DegradedDocumentCount)), "documents requiring repair")
		@Metric("Corruption incidents", numberText(uint64(data.Summary.DegradedDocumentCount)), "local proxy until dedicated incident telemetry exists")
	</section>
	<section class="panel">
		<div class="panel-heading">
			<div>
				<div class="eyebrow">Reliability</div>
				<strong>Repair and corruption evidence</strong>
			</div>
		</div>
		@SignalList(data, "Repair lag")
		@SignalList(data, "Corruption incidents")
	</section>
}

templ SignalList(data DashboardData, name string) {
	<div class="signal-list">
		for _, signal := range data.Signals {
			if name == "" || signal.Name == name {
				<div class={ signalClass(signal.State) }>
					<div>
						<strong>{ signal.Name }</strong>
						<p>{ signal.Detail }</p>
					</div>
					<span>{ signal.State }</span>
				</div>
			}
		}
	</div>
}

templ CoverageItem(name string, state string, detail string) {
	<div class={ signalClass(state) }>
		<div>
			<strong>{ name }</strong>
			<p>{ detail }</p>
		</div>
		<span>{ state }</span>
	</div>
}
